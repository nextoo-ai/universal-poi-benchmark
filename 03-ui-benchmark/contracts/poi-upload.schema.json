{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextoo.io/schemas/poi-ui-upload-v1.json",
  "title": "POI UI upload v1",
  "type": "object",
  "required": ["pois"],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string" },
        "datasetVersion": { "type": "string" },
        "destinationId": { "type": "string" },
        "language": { "type": "string" }
      },
      "additionalProperties": true
    },
    "pois": {
      "type": "array",
      "items": { "$ref": "#/$defs/poi" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "poi": {
      "type": "object",
      "required": ["id", "name", "category", "location"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "subcategory": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "alternateNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "location": {
          "type": "object",
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "locality": { "type": ["string", "null"] },
            "neighborhood": { "type": ["string", "null"] },
            "address": { "type": ["object", "string", "null"] }
          },
          "additionalProperties": true
        },
        "links": { "type": ["object", "array", "null"] },
        "media": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/$defs/media" } },
            { "type": "object" },
            { "type": "null" }
          ]
        },
        "ratings": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/$defs/rating" } },
            { "type": "object" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    },
    "rating": {
      "type": "object",
      "required": ["provider", "value"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "scale": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "additionalProperties": false
        },
        "normalizedScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewCount": { "type": ["integer", "null"], "minimum": 0 },
        "observedAt": { "type": ["string", "null"] },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": true
    },
    "media": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sourcePageUrl": { "type": ["string", "null"], "format": "uri" },
        "creator": { "type": ["string", "null"] },
        "attribution": { "type": ["string", "null"] },
        "license": { "type": ["object", "string", "null"] },
        "rightsStatus": {
          "enum": ["verified-permissive", "declared", "unknown", "conflicting"]
        }
      },
      "additionalProperties": true
    }
  }
}
